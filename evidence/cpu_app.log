#   실행 계정: ashofrondol (uid=1000) — root 아님 (B1-2-P1 충족)
#   바이너리 : $AGENT_HOME/agent-leak-app  (md5 0fb02e12554328b32e6e1adac861630e, repo bin/ 과 동일)
#
#   사전 환경변수:
#   export AGENT_HOME=/home/ashofrondol/b12_sandbox/agent-app
#   export AGENT_PORT=15034
#   export AGENT_UPLOAD_DIR="$AGENT_HOME/upload_files"
#   export AGENT_KEY_PATH="$AGENT_HOME/api_keys"      # secret.key = "agent_api_key_test"
#   export AGENT_LOG_DIR=/home/ashofrondol/b12_sandbox/logs
#   실험 환경변수: Before: MEMORY_LIMIT=512 CPU_MAX_OCCUPY=80 MULTI_THREAD_ENABLE=false / After: MEMORY_LIMIT=512 CPU_MAX_OCCUPY=10 MULTI_THREAD_ENABLE=false
#
#   수집 명령:
#   cd $REPO && EVIDENCE_DIR="$PWD/evidence" SAMPLE_INTERVAL=3 AFTER_FACTOR=60 CPU_BEFORE_TIMEOUT=300 \
#     bash src/experiments/00_run_experiments.sh cpu
#
#   찾아볼 핵심 라인:
#     Before  [INFO] [CpuWorker] Started. Maximum CPU Limit: 80%
#             [INFO] [CpuWorker] Current Load: 5.00% → 8.98 → 15.43 → … → 47.33 → 53.72%  (3초 간격)
#             [CRITICAL] [CpuWorker] CPU Threshold Violated! (53.720000000000006%).  ← 보호 종료 (09:08:11)
#     After   [INFO] [CpuWorker] Started. Maximum CPU Limit: 10%
#             [INFO] [CpuWorker] Peak reached (10.00%). Starting cooldown...
#             [INFO] [CpuWorker] Cooldown complete (5.00%). Resuming load increase...   (반복 순환)
#   ※ 트립 지점은 CPU_MAX_OCCUPY(80) 가 아니라 부팅 배너가 경고하는 고정 50% 다.
#     Before 부트 배너: [ CPU ] Limit: 80%  [ WARNING: Recommend Under 50% ]
#     After  부트 배너: [ CPU ] Limit: 10%  [ OK ]  → 시나리오 자체가 [Healthy System Monitoring] 로 바뀐다.
#   ※ 과제 PDF 예시의 'WATCHDOG … SIGTERM' 문자열은 로그에 없다. 다만 프로세스 종료 코드는
#     143 = 128+15(SIGTERM) 으로, 보호 조치가 SIGTERM 경로임을 뒷받침한다(cpu_top_ps.txt §3 참조).
