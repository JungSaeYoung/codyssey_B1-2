#   ※ 이 파일은 위 환경에서 실제로 실행해 받은 산출물이다. 과제 PDF 예시가 아니다.
#   수집 시각: 2026-08-26 09:02:35 ~ 09:06:13 (KST)
#   호스트   : devjsy / Ubuntu 24.04.4 LTS / Linux 6.8.0-138-generic x86_64 / 16 vCPU / 62 GiB RAM / CLK_TCK=100
#   실행 계정: ashofrondol (uid=1000) — root 아님 (B1-2-P1 충족)
#   바이너리 : $AGENT_HOME/agent-leak-app  (md5 0fb02e12554328b32e6e1adac861630e, repo bin/ 과 동일)
#
#   사전 환경변수:
#   export AGENT_HOME=/home/ashofrondol/b12_sandbox/agent-app
#   export AGENT_PORT=15034
#   export AGENT_UPLOAD_DIR="$AGENT_HOME/upload_files"
#   export AGENT_KEY_PATH="$AGENT_HOME/api_keys"      # secret.key = "agent_api_key_test"
#   export AGENT_LOG_DIR=/home/ashofrondol/b12_sandbox/logs
#   실험 환경변수: Before: MEMORY_LIMIT=256 CPU_MAX_OCCUPY=10 MULTI_THREAD_ENABLE=false / After: MEMORY_LIMIT=512 CPU_MAX_OCCUPY=10 MULTI_THREAD_ENABLE=false
#
#   수집 명령:
#   # (1) 실험 파이프라인 — 앱 기동/전환/증거 수집 전체를 자동화
#   cd $REPO && EVIDENCE_DIR="$PWD/evidence" SAMPLE_INTERVAL=3 AFTER_FACTOR=60 \
#     OOM_BEFORE_TIMEOUT=300 RUN_AFTER=1 bash src/experiments/00_run_experiments.sh oom
#   
#   # (2) 위 파이프라인이 도는 동안 별도 셸에서 관제 스크립트를 3초 간격 반복 실행
#   #     (cron 매분 대신 실험 구간을 촘촘히 보기 위한 것. 스크립트 자체는 무수정)
#   while :; do bash "$REPO/src/monitor.sh"; sleep 3; done
#
#   컬럼 의미 — SYS_* = 호스트 전체 / PROC_* = 대상 프로세스(ps -o rss=,pcpu= -p <PID>).
#   SYS_MEM 은 free 기반 호스트 전체값이라 앱 heap 증가가 거의 반영되지 않는다.
#     요구사항 B1-2-A1 이 말하는 '대상 프로세스의 물리 메모리' 는 PROC_RSS 컬럼이다.
#   PROC_CPU 는 ps %CPU = '프로세스 시작 이후 누적 평균' 이다(순간값 아님).
#     순간값은 cpu_top_ps.txt 의 /proc/<pid>/stat 1초 델타 측정 표를 볼 것.
# =============================================================================


