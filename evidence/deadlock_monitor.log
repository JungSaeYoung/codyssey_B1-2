#   while :; do bash "$REPO/src/monitor.sh"; sleep 3; done
#
#   컬럼 의미 — SYS_* = 호스트 전체 / PROC_* = 대상 프로세스(ps -o rss=,pcpu= -p <PID>).
#   SYS_MEM 은 free 기반 호스트 전체값이라 앱 heap 증가가 거의 반영되지 않는다.
#     요구사항 B1-2-A1 이 말하는 '대상 프로세스의 물리 메모리' 는 PROC_RSS 컬럼이다.
#   PROC_CPU 는 ps %CPU = '프로세스 시작 이후 누적 평균' 이다(순간값 아님).
#     순간값은 cpu_top_ps.txt 의 /proc/<pid>/stat 1초 델타 측정 표를 볼 것.
# =============================================================================


