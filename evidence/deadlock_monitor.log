#   cd $REPO && EVIDENCE_DIR="$PWD/evidence" SAMPLE_INTERVAL=3 FREEZE_SECS=60 DEADLOCK_TIMEOUT=300 \
#     DEADLOCK_AFTER_VERIFY=180 RUN_AFTER=1 bash src/experiments/00_run_experiments.sh deadlock
#   
#   # (2) 위 파이프라인이 도는 동안 별도 셸에서 관제 스크립트를 3초 간격 반복 실행
